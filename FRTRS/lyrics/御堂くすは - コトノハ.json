[{"time":41.68,"original":"不意にあなたが呟く言葉　胸の奥駆け巡る","translated":""},{"time":48.07,"original":"濡れた髪梳き　頬撫でる白い指にくちづけた","translated":""},{"time":54.98,"original":"ウワゴトのよう　掠れた声で","translated":""},{"time":58.18,"original":"繰り返し呼ぶだけ　注がれる熱に全て委ねて","translated":""},{"time":67.08,"original":"いつも震えていた　失う事恐れては","translated":""},{"time":75.09,"original":"もう求めるしか出来ない","translated":""},{"time":84.46,"original":"永遠より遠ざかる　指の隙間ひとひらの","translated":""},{"time":91.07,"original":"泡沫の華　乱れ咲き色を失くす","translated":""},{"time":97.62,"original":"そっと重ねた唇から　零れた言ノ葉","translated":""},{"time":104.27,"original":"呼ぶ声は　届かない","translated":""},{"time":124.25,"original":"空虚な心　埋める事など私では叶わない","translated":""},{"time":130.83,"original":"抜殻の身体を　きつく抱いた","translated":""},{"time":136.52,"original":"やがて翼もがれ　吐息さえも凍りついてく","translated":""},{"time":146.57,"original":"何故ここで途絶えるの","translated":""},{"time":154,"original":"霞む視界　触れた身体は熱を失って","translated":""},{"time":160.63,"original":"孤高の華　存在さえ塗り潰され","translated":""},{"time":167.11,"original":"濁る瞳　二度と映らない","translated":""},{"time":171.03,"original":"何を引き換えに差し出したら救えたの","translated":""},{"time":180.49,"original":"揺らぐ事無き誓い　誰にも塗り潰させない","translated":""},{"time":187.09,"original":"閉ざされた蕾　もう一度　色づくまで","translated":""},{"time":193.76,"original":"永遠に消えない傷痕　この胸に残して","translated":""},{"time":200.32,"original":"白き夢は　褪めていく","translated":""}]